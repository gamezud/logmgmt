# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. This file only documents which settings are required.

# --- Postgres admin/superuser (docker-compose init scripts, migrations, `make psql`) ---
POSTGRES_USER=logmgmt_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=logmgmt
POSTGRES_PORT=5432

# --- Least-privilege application role ---
# The backend must connect as this role, never as POSTGRES_USER. POSTGRES_USER
# is a Postgres superuser and superusers always bypass Row-Level Security, so
# using it from the backend would silently defeat tenant isolation.
# app_user only has SELECT/INSERT on events (no UPDATE/DELETE — logs are append-only).
APP_DB_USER=app_user
APP_DB_PASSWORD=changeme

# --- Partition maintenance (used by `make partitions`) ---
# How many days of future partitions to keep pre-created, and how far back to
# backfill for slightly-late data. Rows outside this window still land safely
# in the events_default partition rather than failing the insert.
PARTITION_DAYS_AHEAD=7
PARTITION_DAYS_BACK=1
# How many days of partitions to keep before dropping them (assignment requires >= 7).
PARTITION_RETENTION_DAYS=7
