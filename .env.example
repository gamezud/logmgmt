# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. This file only documents which settings are required.

# --- Postgres admin/superuser (docker-compose init scripts, migrations, `make psql`) ---
POSTGRES_USER=logmgmt_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=logmgmt
POSTGRES_PORT=5432
# Not a secret — just lets ingest scripts (ingest/db.py) run against a
# non-default host later without hardcoding "localhost".
POSTGRES_HOST=localhost

# --- Least-privilege application role ---
# The backend must connect as this role, never as POSTGRES_USER. POSTGRES_USER
# is a Postgres superuser and superusers always bypass Row-Level Security, so
# using it from the backend would silently defeat tenant isolation.
# app_user only has SELECT/INSERT on events (no UPDATE/DELETE — logs are append-only).
APP_DB_USER=app_user
APP_DB_PASSWORD=changeme

# --- Backend JWT auth ---
# JWT_SECRET_KEY MUST be overridden with a real random value before starting
# the backend — backend/config.py refuses to start if this is still the
# placeholder below, because this file is committed to the repo and its
# placeholder is therefore public: anyone who can read the repo could mint a
# validly-signed JWT for any tenant/role, which defeats every RLS policy in
# the system. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
# How long an access token stays valid. No refresh token in this session —
# see docs/DECISIONS.md for the accepted tradeoff (a token issued to an
# account that's later deleted/role-changed stays valid until it expires).
JWT_EXPIRE_MINUTES=60
BACKEND_PORT=8000

# The frontend's origin, for CORS (backend/main.py's CORSMiddleware). Vite's
# default dev port — change this if you serve the frontend from elsewhere.
FRONTEND_ORIGIN=http://localhost:5173

# --- Alert engine (alerting/engine.py) ---
# How often the scheduled alert check runs. See docs/DECISIONS.md for why
# a scheduled poll instead of streaming, at this scale.
ALERT_POLL_INTERVAL_SECONDS=30
# Optional. If set, a JSON POST is sent here for every fired alert. Left
# unset (the default), the engine still fires and records alerts normally —
# it just never attempts delivery; this is not an error condition.
ALERT_WEBHOOK_URL=

# --- Partition maintenance (used by `make partitions`) ---
# How many days of future partitions to keep pre-created, and how far back to
# backfill for slightly-late data. Rows outside this window still land safely
# in the events_default partition rather than failing the insert.
PARTITION_DAYS_AHEAD=7
PARTITION_DAYS_BACK=1
# How many days of partitions to keep before dropping them (assignment requires >= 7).
PARTITION_RETENTION_DAYS=7

# --- Frontend build (docker-compose.yml's `frontend` service build arg) ---
# Baked into the compiled JS bundle at `docker compose build` time — Vite
# has no runtime env mechanism, so this can't be changed after the image is
# built. "/api" (relative, not a full URL) is correct for BOTH appliance and
# SaaS modes because both put the frontend and backend behind the same
# Caddy origin (path-based routing, not subdomains — see docs/DECISIONS.md
# #50/#51). You should not normally need to change this in either mode.
#
# This is a DIFFERENT setting from frontend/.env.example's
# VITE_API_BASE_URL, which is for `npm run dev` and must stay an absolute
# URL (http://localhost:8000) instead — do not copy this value there, see
# the comment in frontend/.env.example for why.
VITE_API_BASE_URL=/api

# --- Caddy TLS (SaaS mode only — docker-compose.saas.yml) ---
# The real domain reviewers will hit, e.g. logmgmt.example.com. DNS for it
# must already point at this machine's public IP before `caddy` starts, or
# the Let's Encrypt HTTP-01 challenge will fail. Leave unset in appliance
# mode — Caddyfile (not Caddyfile.saas) is used there instead, which uses
# `tls internal` (a local self-signed cert) and never reads this.
SITE_DOMAIN=
# Contact email Let's Encrypt uses to warn about certificate problems
# (e.g. upcoming expiry it failed to auto-renew). Not required for issuance
# to succeed, but Caddy/Let's Encrypt recommend setting it. Leave unset in
# appliance mode, same as SITE_DOMAIN above.
ACME_EMAIL=

# SaaS mode WITHOUT a domain (public IP only) — used INSTEAD of
# SITE_DOMAIN/ACME_EMAIL above, together with docker-compose.saas-ip.yml
# (layered on top of docker-compose.saas.yml: `docker compose -f
# docker-compose.yml -f docker-compose.saas.yml -f docker-compose.saas-ip.yml
# up -d --wait`). Set this to the VM's public IP, e.g. 203.0.113.10 — find it
# with `curl -s ifconfig.me`. Caddyfile.saas-ip uses `tls internal`
# (self-signed, same browser warning as appliance mode) instead of Let's
# Encrypt, since Let's Encrypt cannot issue a certificate for a bare IP
# address. Leave unset if you have a real domain — use SITE_DOMAIN instead.
SITE_ADDRESS=
