# SaaS override, no-domain variant: self-signed TLS bound to the VM's public
# IP instead of Let's Encrypt (see Caddyfile.saas for the with-domain case).
# Mounted in place of ./Caddyfile.saas by docker-compose.saas-ip.yml, layered
# on top of docker-compose.saas.yml — backend/postgres stay unpublished
# (ports: [] from docker-compose.saas.yml) exactly like the with-domain SaaS
# case, without relying on a host firewall as the only thing standing between
# them and the internet (see docs/DECISIONS.md #54 for why the earlier plan —
# plain docker-compose.yml plus a manually-run ufw rule — was rejected).
#
# SITE_ADDRESS comes from the environment (docker-compose.saas-ip.yml passes
# it from .env) — the VM's public IP, e.g. 203.0.113.10. Routing logic below
# is otherwise identical to Caddyfile / Caddyfile.saas.
{$SITE_ADDRESS} {
    # No public domain, so Let's Encrypt can't issue a cert for this site at
    # all (same reason as the appliance Caddyfile) — tls internal mints one
    # from Caddy's own local CA for this IP instead. Reviewers get the same
    # browser TLS warning as appliance mode — see docs/setup_saas.md for how
    # to click through it.
    tls internal

    handle_path /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:8080
    }
}
