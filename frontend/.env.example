# Copy to .env.local (Vite's own convention — gitignored, unlike .env.example)
# and adjust if the backend isn't at the default local address.
#
# This MUST stay an absolute URL, unlike the root .env.example's
# VITE_API_BASE_URL=/api (used for the Docker build behind Caddy) — those
# are two different settings for two different situations, not the same
# value duplicated. `npm run dev`'s Vite dev server (vite.config.js) has no
# server.proxy configured, so it has no idea what to do with a relative
# path like "/api" — it would just request http://localhost:5173/api/...,
# which nothing answers, and you'd get a 404 from Vite itself with no clue
# that the real cause is a copy-pasted value from the wrong .env.example.
VITE_API_BASE_URL=http://localhost:8000
